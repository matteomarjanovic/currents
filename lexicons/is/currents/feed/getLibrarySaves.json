{
  "lexicon": 1,
  "id": "is.currents.feed.getLibrarySaves",
  "defs": {
    "main": {
      "type": "query",
      "description": "List all of an actor's saved images across collections and unsorted saves, deduplicated by image. Auth is optional when actor is provided; otherwise the authenticated viewer is used.",
      "parameters": {
        "type": "params",
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier",
            "description": "DID or handle of the actor whose images to list. Defaults to the authenticated viewer."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "saves"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "saves": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "is.currents.feed.defs#saveView"
              }
            }
          }
        }
      }
    }
  }
}
