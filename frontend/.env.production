# Committed, don't add any secrets here. Netlify UI env vars override this file.
# Production backend — used by `npm run build`, `build:mobile` (vite mode=production, i.e. releases).
PUBLIC_APPVIEW_URL=https://api.currents.is

# Staged rollout: 1 = organize mode + supporter/subscription UI are visible to
# moderators only. Clear it (here and in the Netlify env, if set there) to
# launch the features for everyone.
PUBLIC_PREVIEW_FEATURES=1

# Paddle LIVE (supporter tier) — fill with the live client token (live_...) and
# price ids (pri_...) at launch, here or in the Netlify UI. Empty values keep
# the subscribe buttons disabled ("Supporter subscriptions are opening soon").
PUBLIC_PADDLE_ENVIRONMENT=production
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_PRICE_MONTHLY=
PUBLIC_PADDLE_PRICE_YEARLY=
