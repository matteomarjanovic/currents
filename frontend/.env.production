# Committed, don't add any secrets here. Netlify UI env vars override this file.
# Production backend — used by `npm run build`, `build:mobile` (vite mode=production, i.e. releases).
PUBLIC_APPVIEW_URL=https://api.currents.is
# Keep the existing Netlify web build cross-origin until Cutover B. The Scaleway SSR image sets
# this to an empty string so browser calls use same-origin paths through Caddy.
PUBLIC_WEB_APPVIEW_URL=https://api.currents.is

# Keyboard behavior baked into the viewport meta: on web the keyboard scrolls the
# focused input into view. The Capacitor build scripts override this with
# overlays-content (process env beats .env files) — see app.html.
PUBLIC_INTERACTIVE_WIDGET=resizes-visual

# Privacy-preserving product analytics. These are public tracker identifiers, not secrets.
# Development builds leave both empty; runtime code also limits web tracking to currents.is.
PUBLIC_UMAMI_SCRIPT_URL=https://mm-umami.netlify.app/script.js
PUBLIC_UMAMI_WEBSITE_ID=d93794c5-c02d-4706-847c-a6f3f9cec4de

# Polar LIVE (supporter tier). These IDs are public and are also the defaults
# for release Docker builds, which run without Compose build arguments.
PUBLIC_POLAR_PRODUCT_MONTHLY=6717e6de-771b-46bb-a0bd-cda4456bd92e
PUBLIC_POLAR_PRODUCT_YEARLY=4b4295d5-08d4-4d06-a72f-9fc93a999519
