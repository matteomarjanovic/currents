# Committed, don't add any secrets here.
# Development backend — used by `npm run dev`, `dev:android`, `dev:ios` (vite mode=development).
# PUBLIC_APPVIEW_URL=https://api-dev.currents.is
PUBLIC_APPVIEW_URL=https://api.currents.is

# Preview gate off in dev — everyone sees organize + supporter UI.
PUBLIC_PREVIEW_FEATURES=

# Keyboard behavior baked into the viewport meta: on web the keyboard scrolls the
# focused input into view. The Capacitor build scripts override this with
# overlays-content (process env beats .env files) — see app.html.
PUBLIC_INTERACTIVE_WIDGET=resizes-visual

# Polar sandbox (supporter tier). The product vars take the product UUIDs from
# the sandbox dashboard (Products > Currents Supporter monthly/yearly), not
# dollar amounts. Empty values keep the subscribe buttons disabled.
PUBLIC_POLAR_PRODUCT_MONTHLY=17ed7495-b713-4236-95b8-572ad4e9a706
PUBLIC_POLAR_PRODUCT_YEARLY=a9016507-9cde-40c7-bcf5-8317ac497ec6
