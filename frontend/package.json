{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"prebuild": "node scripts/gen-og-images.mjs",
		"build": "vite build",
		"gen-tid": "node scripts/gen-tid.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint src e2e scripts",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"build:mobile": "node scripts/check-native-dependencies.mjs && CAPACITOR=1 PUBLIC_INTERACTIVE_WIDGET=overlays-content vite build && cap sync",
		"cap:sync": "node scripts/check-native-dependencies.mjs && cap sync",
		"cap:open:android": "cap open android",
		"cap:open:ios": "cap open ios",
		"dev:android": "node scripts/check-native-dependencies.mjs && CAPACITOR=1 PUBLIC_INTERACTIVE_WIDGET=overlays-content vite build --mode development && cap sync && cap run android",
		"dev:ios": "node scripts/check-native-dependencies.mjs && CAPACITOR=1 PUBLIC_INTERACTIVE_WIDGET=overlays-content vite build --mode development && cap sync && cap run ios",
		"test:unit": "vitest run && node --test scripts/check-native-dependencies.test.mjs scripts/npm-registry-auth.test.mjs"
	},
	"devDependencies": {
		"@capacitor/assets": "^4.0.0",
		"@csstools/postcss-oklab-function": "^5.0.6",
		"@csstools/postcss-progressive-custom-properties": "^5.1.1",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/instrument-sans": "^5.2.8",
		"@fontsource/instrument-sans": "^5.2.8",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.577.0",
		"@playwright/test": "^1.61.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"@vite-pwa/sveltekit": "^2.0.0",
		"@vite-pwa/workbox-swkit": "^8.0.13",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"gray-matter": "^4.0.3",
		"layerchart": "^2.0.0-next.48",
		"mdsvex": "^0.12.7",
		"magicast": "^0.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"satori": "^0.33.5",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.57.2",
		"svelte-check": "^4.4.2",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.57.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.12",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@capacitor-community/safe-area": "^8.0.0",
		"@capacitor/android": "^8.4.3",
		"@capacitor/app": "^8.0.0",
		"@capacitor/browser": "^8.0.0",
		"@capacitor/camera": "^8.0.0",
		"@capacitor/cli": "^8.4.3",
		"@capacitor/core": "^8.4.3",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/ios": "^8.4.3",
		"@capacitor/splash-screen": "^8.0.0",
		"@capacitor/status-bar": "^8.0.0",
		"@capawesome/capacitor-accessibility-preferences": "^0.1.2",
		"@humanspeak/svelte-motion": "^1.2.1",
		"@masonry-grid/svelte": "^1.1.1",
		"@polar-sh/checkout": "^0.4.0",
		"mode-watcher": "^1.1.0",
		"send-intent": "^7.0.0"
	},
	"optionalDependencies": {
		"@capawesome-team/capacitor-secure-preferences": "^0.4.1"
	},
	"overrides": {
		"minimatch@>=7 <11.0.1": "^11.0.4",
		"postcss-selector-parser@6": "^6.1.5",
		"fflate@0.7": "^0.7.5",
		"@trapezedev/project": "^7.1.11",
		"runed@>=0.32 <0.38": "^0.38.0",
		"xcode": "^4.0.0"
	}
}
